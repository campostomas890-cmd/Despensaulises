<!DOCTYPE html>
<html>
  <head>
    <title>{{title}} | Despensa Ulises</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body>
    <main>
      <header>
        <nav class="navbar">
          <a class="navbar-brand" href="/" aria-label="Despensa Ulises">
            <img src="/images/logo.png" alt="Despensa Ulises">
          </a>
          <input class="navbar-toggle" type="checkbox" id="navbar-toggle" aria-label="Abrir o cerrar menú">
          <label class="navbar-toggle-label" for="navbar-toggle">
            <span></span>
            <span></span>
            <span></span>
          </label>
          <ul class="navbar-links">
            <li>
              <a class="navbar-link" href="/">Inicio</a>
            </li>
            <li>
              <a class="navbar-link" href="/catalogo">Catálogo</a>
            </li>
            <li>
              <a class="navbar-link" href="/#contacto">Contacto</a>
            </li>
          </ul>
        </nav>
      </header>
      {{{body}}}
    </main>
    <footer class="site-footer">
      <small class="site-copyright">© 2026 Despensa Ulises. Todos los derechos reservados.</small>
      <div class="footer-contact">
        <div class="footer-phone">
          <span>Teléfono:</span>
          {{#if whatsappNumber}}
            <a href="tel:+{{whatsappNumber}}">+{{whatsappNumber}}</a>
          {{else}}
            <span>Número pendiente de configurar</span>
          {{/if}}
        </div>
        {{#if whatsappNumber}}
          <a class="whatsapp-link" href="https://wa.me/{{whatsappNumber}}" target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp al +{{whatsappNumber}}">
        {{else}}
          <span class="whatsapp-link whatsapp-link-disabled" aria-disabled="true" title="Configura WHATSAPP_NUMBER en el archivo .env">
        {{/if}}
          <svg class="whatsapp-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <path d="M16 3.2A12.7 12.7 0 0 0 5.1 22.4L3.4 28.6l6.4-1.7A12.8 12.8 0 1 0 16 3.2Zm0 23.2c-2 0-4-.6-5.7-1.6l-.4-.2-3.8 1 1-3.7-.3-.4A10.1 10.1 0 1 1 16 26.4Zm5.5-7.6c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.3-.5-2.5-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.6c.2-.2.2-.4.3-.6.1-.2 0-.4 0-.6-.1-.2-.7-1.7-1-2.3-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.6s1.1 3 1.2 3.2c.2.2 2.2 3.4 5.4 4.8.8.3 1.4.5 1.8.6.8.2 1.5.2 2.1.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.5Z"/>
          </svg>
          <span>WhatsApp</span>
        {{#if whatsappNumber}}
          </a>
        {{else}}
          </span>
        {{/if}}
      </div>
    </footer>
  </body>
</html>
